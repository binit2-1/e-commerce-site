{
  "name": "e-commerce-site",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @shop/api --filter @shop/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test": "vitest run",
    "db:schema": "pnpm --filter @shop/api db:schema",
    "db:seed": "pnpm --filter @shop/api db:seed",
    "db:reset": "pnpm --filter @shop/api db:reset",
    "demo": "pnpm --filter @shop/demo dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "playwright-core": "1.48.2",
    "postcss": "^8.5.32",
    "vitest": "^3"
  }
}
